# Copy to .env for local development. On Vercel, set these in
# Project Settings -> Environment Variables instead (the .env file is not deployed).

# Port for local development (ignored on Vercel)
PORT=5000

# MongoDB connection string - MongoDB Atlas recommended (free tier works):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/poly_learning_foundation?retryWrites=true&w=majority
# In Atlas -> Network Access, allow 0.0.0.0/0 (Vercel functions have no fixed IPs).
# Leave empty to run with the built-in project/role data only (forms will answer 503).
MONGODB_URI=

# Comma-separated origins allowed to call the API; "*" is a wildcard.
# Local: http://localhost:5173   Vercel: https://your-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Long random string. Enables GET /api/admin/inquiries and /api/admin/subscribers
# (send it as `Authorization: Bearer <token>`). Leave empty to disable the admin endpoints.
ADMIN_TOKEN=

# development | production (Vercel sets production automatically)
NODE_ENV=development
